ALTER TABLE Wagon_Refrigerated_Car ADD CONSTRAINT FKWagon_Refr893918 FOREIGN KEY (id) REFERENCES Wagon_Model (id);
ALTER TABLE Wagon ADD CONSTRAINT FKWagon943492 FOREIGN KEY (modelID) REFERENCES Wagon_Model (id);
ALTER TABLE Rail_Line ADD CONSTRAINT FKRail_Line37767 FOREIGN KEY (startID) REFERENCES Endpoint (endpointID);
ALTER TABLE Rail_Line ADD CONSTRAINT FKRail_Line801339 FOREIGN KEY (endID) REFERENCES Endpoint (endpointID);
ALTER TABLE Operator_Rolling_Stock ADD CONSTRAINT FKOperator_R328286 FOREIGN KEY (operator) REFERENCES Operator (shortName);
ALTER TABLE Operator_Rolling_Stock ADD CONSTRAINT FKOperator_R604707 FOREIGN KEY (Rolling_Stockid) REFERENCES Rolling_Stock (id);