CREATE TABLE Endpoint (endpointID number(10), name varchar2(255) NOT NULL, locationID number(10) NOT NULL, PRIMARY KEY (endpointID));
CREATE TABLE FreightYard (id number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Line_Segment (id number(10), Rail_LineId number(10) NOT NULL, orderPosition number(10) NOT NULL, max_weight float(10) NOT NULL, length number(10) NOT NULL, Line_TypeID number(10) NOT NULL, PRIMARY KEY (id), CONSTRAINT RailLinePositions UNIQUE (Rail_LineId, orderPosition));
CREATE TABLE Line_Type (id number(10), isElectric varchar2(255) NOT NULL, numberTracks number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Location (id number(10), latitude varchar2(255) NOT NULL, longitude varchar2(255) NOT NULL, PRIMARY KEY (id), CONSTRAINT coordinates UNIQUE (latitude, longitude));
CREATE TABLE Locomotive (id number(10), rollingStockID number(10) NOT NULL, name varchar2(255) NOT NULL UNIQUE, make varchar2(255) NOT NULL, modelID number(10) NOT NULL, entryYear number(10) NOT NULL, gauge number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Locomotive_Diesel (id number(10) NOT NULL, maxFuelCapacity number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Locomotive_Electric (id number(10) NOT NULL, voltage number(10) NOT NULL, frequency number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Locomotive_Model (id number(10), model varchar2(255) NOT NULL, numberBogies number(10) NOT NULL, bogies varchar2(255) NOT NULL, power number(10) NOT NULL, length number(10) NOT NULL, width number(10) NOT NULL, height number(10) NOT NULL, maxSpeed number(10) NOT NULL, operationalSpeed number(10) NOT NULL, traction number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Operator (shortName varchar2(255) NOT NULL, name varchar2(255) NOT NULL, VATNumber varchar2(255) NOT NULL UNIQUE, PRIMARY KEY (shortName));
CREATE TABLE Operator_Rolling_Stock (operator varchar2(255) NOT NULL, Rolling_Stockid number(10) NOT NULL, PRIMARY KEY (operator, Rolling_Stockid));
CREATE TABLE Owner (shortName varchar2(255) NOT NULL, name varchar2(255) NOT NULL, VATNumber varchar2(255) NOT NULL UNIQUE, PRIMARY KEY (shortName));
CREATE TABLE Rail_Line (id number(10), name varchar2(255) NOT NULL, ownerID varchar2(255) NOT NULL, startID number(10) NOT NULL, endID number(10) NOT NULL, gauge number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Rolling_Stock (id number(10), "name" varchar2(255) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Station (id number(10) NOT NULL, hasWarehouse number NOT NULL, hasRefrigeratedArea number NOT NULL, hasGrainSilo number NOT NULL, PRIMARY KEY (id));
CREATE TABLE Terminal (id number(10) NOT NULL, hasWarehouse number NOT NULL, hasRefrigeratedArea number NOT NULL, hasGrainSilo number(10) NOT NULL, isIntermodal number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon (id number(10), rollingStockID number(10) NOT NULL, modelID number(10) NOT NULL, serviceYear number(10) NOT NULL, gauge number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon_Boxcar (id number(10) NOT NULL, storedGeneralGoods number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon_Flatcar (id number(10) NOT NULL, storedContainers number(10) NOT NULL, storedVehicles number(10) NOT NULL, storedMachinery number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon_Hopper_Car (id number(10) NOT NULL, storedCoal number(10) NOT NULL, storedGrains number(10) NOT NULL, storedMinerals number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon_Model (id number(10), model varchar2(255) NOT NULL, maker varchar2(255) NOT NULL, numberBogies number(10) NOT NULL, bogies varchar2(255) NOT NULL, length number(10) NOT NULL, width number(10) NOT NULL, height number(10) NOT NULL, weight number(10) NOT NULL, maxSpeed number(10) NOT NULL, payload number(10) NOT NULL, volume number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon_Refrigerated_Car (id number(10) NOT NULL, storedPerishableGoods number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon_Tank_Car (id number(10) NOT NULL, storedLiquids number(10) NOT NULL, storedChemicals number(10) NOT NULL, storedFuel number(10) NOT NULL, PRIMARY KEY (id));
