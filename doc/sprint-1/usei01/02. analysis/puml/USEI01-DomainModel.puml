@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Warehouse {
    - warehouseId: String
}

class Wagon {
    - wagonID: String
}

class Bay {
    - bayNumber: int
    - aisle: int
    - boxCapacity: int
}

class Box {
    - boxID: String
    - sku: String
    - quantity: int
    - expiryDate: LocalDateTime
    - receivedAt: String
    - warehouseId: String
    - aisle: Integer
    - bayNumber: Integer
}

class Item {
    - sku: String
    - itemName: String
    - itemCategory: String
    - unit: String
    - weight: double
    - unitWeight: double
}

class Order {
    - orderID: String
    - dueDate: String
    - priority: int
}

class OrderLines {
    - lineNo: int
    - sku: String
    - qty: int
}

class Returns {
    - returnID: String
    - sku: String
    - qty: int
    - reason: ReturnReasons
    - timestamp: String
    - expiryDate: String
}

class Movements {
    - timestamp: String
    - type: MovementType
    - boxID: String
    - sku: String
    - qty: int
    - fromLocation: String
    - toLocation: String
    - orderID: String
    - notes: String
}

enum MovementType {
    UNLOAD
    DISPATCH
    RELOCATE
    RETURN
}

enum ReturnReasons {
    REMORSE
    DAMAGED
    EXPIRED
    CYCLE_COUNT
}

' Core Relationships
Warehouse "1" *-- "*" Bay : contains
Warehouse "1" *-- "*" Movements : tracks
Warehouse "1" --> "*" Item : has catalog
Warehouse "1" --> "*" Order : manages
Warehouse "1" --> "*" Returns : manages
Warehouse ..> Wagon : receives from

Wagon "1" o-- "*" Box : carries temporarily

Bay "1" o-- "*" Box : stores

Box "*" --> "1" Item : references (via SKU)

Order "1" *-- "*" OrderLines : contains

OrderLines "*" --> "1" Item : references (via SKU)

Returns "*" --> "1" Item : references (via SKU)
Returns "*" --> "1" ReturnReasons : has reason

Movements ..> Box : references (via boxID)

@enduml