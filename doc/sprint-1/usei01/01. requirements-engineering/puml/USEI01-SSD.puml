@startuml
!theme plain
skinparam sequenceArrowThickness 2
skinparam roundcorner 20
skinparam sequenceMessageAlign direction

actor "Terminal Operator" as Operator
participant "System" as System

== Initialize Warehouse System ==

activate Operator
Operator -> System: Load data from .csv files
activate System

alt Load Successful
    System --> Operator: Success
else Load Failed
    System --> Operator: Error list
end

deactivate System

== Query Movement History ==

Operator -> System: Request movement history
activate System

System --> Operator: Movement list
deactivate System

== Export Movements to CSV ==

Operator -> System: Request to export movement to csv
activate System

System --> Operator: CSV content
deactivate System

== Dispatch Operation ==

Operator -> System: Request to dispatch
activate System

alt Dispatch Successful
    System --> Operator: Success
else Insufficient Stock
    System --> Operator: Failure
end

deactivate System

== Relocate Box ==

Operator -> System: Request to relocate box
activate System

alt Relocation Successful
    System --> Operator: Success
else Box Not Found / No Capacity
    System --> Operator: Failure
end

deactivate System

@enduml