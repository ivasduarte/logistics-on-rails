@startuml
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Terminal\nOperator" as Operator
participant ":Warehouse" as WH
participant ":Bay" as Bay
participant ":Box" as Box
participant ":Movements" as Mov

autonumber

== Stock Initialization / Unloading Wagons ==

Operator -> WH : unloadWagonsIntoBays()
activate WH

loop for each wagon
    loop for each box in wagon
        WH -> WH : find available bay()

        WH -> Bay : hasCapacity()
        activate Bay
        Bay --> WH : true/false
        deactivate Bay

        alt bay has capacity
            WH -> Bay : addBoxInFEFOOrder(box)
            activate Bay
            Bay -> Bay : boxes.add(box)
            Bay -> Bay : Collections.sort(boxes)
            Bay --> WH : true
            deactivate Bay

            WH -> Box : setLocation(warehouseId, aisle, bayNumber)

            WH -> Mov : new Movements(UNLOAD, boxID, sku, qty, from, to)
            WH -> WH : movementHistory.add(movement)

        else no capacity
            WH -> WH : importErrors.add("No capacity")
        end
    end

    WH -> WH : clear wagon boxes
end

WH --> Operator : unloading complete
deactivate WH

autonumber stop

== Dispatch Operation (FEFO/FIFO Consumption) ==

autonumber

Operator -> WH : dispatch(sku, quantity, warehouseId)
activate WH

WH -> WH : get bays

loop for each bay while remaining > 0
    WH -> Bay : dispatchFromFront(sku, remaining, movements, bayLocation, orderId)
    activate Bay

    loop while iterator.hasNext() AND remaining > 0
        Bay -> Bay : box = iterator.next()

        alt box.sku matches
            Bay -> Box : getQuantity()
            activate Box
            Box --> Bay : quantity
            deactivate Box

            alt quantity <= remaining
                Bay -> Bay : iterator.remove()

                Bay -> Mov : new Movements(DISPATCH, boxID, sku, consumed, from, to)
                Bay -> WH : movements.add(movement)
                Bay -> Bay : remaining -= quantity

            else quantity > remaining
                Bay -> Box : setQuantity(quantity - remaining)
                Bay -> Mov : new Movements(DISPATCH, boxID, sku, remaining, from, to)
                Bay -> WH : movements.add(movement)
            end
        end
    end

    Bay --> WH : remaining
    deactivate Bay
end

alt remaining == 0
    WH --> Operator : true (fully dispatched)
else remaining > 0
    WH --> Operator : false (insufficient stock)
end

deactivate WH

autonumber stop


== Relocation ==

autonumber

Operator -> WH : relocate(boxId, newWarehouseId, newAisle, newBayNumber)
activate WH

loop for each warehouse and bay
    WH -> Bay : removeBox(boxId)
    activate Bay

    alt box found
        Bay -> Bay : iterator.remove()
        Bay --> WH : box
    else not found
        Bay --> WH : null
    end
    deactivate Bay
end

alt box not found
    WH -> WH : importErrors.add("Box not found")
    WH --> Operator : false

else box found
    WH -> WH : validate target bay\n(exists and has capacity)

    alt validation fails
        WH -> Bay : addBoxInFEFOOrder(box)
        WH -> WH : importErrors.add(error)
        WH --> Operator : false

    else validation ok
        WH -> Bay : addBoxInFEFOOrder(box)
        activate Bay
        Bay -> Bay : boxes.add(box)
        Bay -> Bay : Collections.sort(boxes)
        Bay --> WH : true
        deactivate Bay

        WH -> Box : setLocation(newWarehouseId, newAisle, newBayNumber)
        WH -> Mov : new Movements(RELOCATE, boxID, sku, qty, fromLoc, toLoc)
        activate Mov
        WH -> WH : movementHistory.add(movement)

        WH --> Operator : true
    end
end

deactivate WH

@enduml