@startuml

class Warehouse {
    - wagons: Map<Wagon, Set<Box>>
    - warehouses: Map<String, Set<Bay>>
    - items: Map<String, Item>
    - order_lines: Map<Order, Set<OrderLines>>
    - orders: Map<String, Order>
    - returns: Map<String, Returns>
    - importErrors: List<String>
    - movementHistory: List<Movements>
    + loadAllData(): void
    + getItems(lines: List<String>): void
    + getWagons(lines: List<String>): void
    + getBays(lines: List<String>): void
    + getOrders(lines: List<String>): void
    + getOrderLines(lines: List<String>): void
    + getReturns(lines: List<String>): void
    + insertBox(box: Box): void
    + findBay(sku: String): Bay
    + findAlternativeBay(sku: String): Bay
    + unloadWagonsIntoBays(): void
    + dispatch(sku: String, quantity: int, warehouseId: String): boolean
    + relocate(boxId: String, newWarehouseId: String, newAisle: int, newBayNumber: int): boolean
    + allocateOrder(orderId: String, strictMode: boolean): OrderAllocationResult
    + printMovementHistory(): void
    + exportToCSV(): String
}

class Bay {
    - bayNumber: int
    - aisle: int
    - boxCapacity: int
    - boxes: LinkedList<Box>
    + getBayNumber(): int
    + getAisle(): int
    + getBoxCapacity(): int
    + getBoxes(): LinkedList<Box>
    + getCurrentBoxCount(): int
    + hasCapacity(): boolean
    + addBoxInFEFOOrder(box: Box): boolean
    + dispatchFromFront(sku: String, quantity: int): int
    + dispatchFromFront(sku: String, quantity: int, movements: List<Movements>, bayLocation: String, orderId: String): int
    + removeBox(boxId: String): Box
    + findBox(boxId: String): Box
    + getSkuQuantity(sku: String): int
}

class Box {
    - boxID: String
    - sku: String
    - quantity: int
    - expiryDate: LocalDateTime
    - receivedAt: String
    - warehouseId: String
    - aisle: Integer
    - bayNumber: Integer
    + getBoxID(): String
    + getSku(): String
    + getQuantity(): int
    + setQuantity(quantity: int): void
    + getExpiryDate(): LocalDateTime
    + getReceivedAt(): String
    + hasExpirationDate(): boolean
    + getWarehouseId(): String
    + getAisle(): Integer
    + getBayNumber(): Integer
    + setLocation(warehouseId: String, aisle: int, bayNumber: int): void
    + compareTo(o: Box): int
}

interface Comparable<Box> {
    +compareTo(o: Box): int
}

class Item {
    - sku: String
    - itemName: String
    - itemCategory: String
    - unit: String
    - weight: double
    - unitWeight: double
}

class Wagon {
    - wagonID: String
}

class Order {
    - orderID: String
    - priority: int
    - dueDate: String
}

class OrderLines {
    - lineNo: int
    - sku: String
    - qty: int
}

class Returns {
    - returnID: String
    - sku: String
    - qty: int
    - reason: ReturnReasons
    - timestamp: String
    - expiryDate: String
    - discarded: boolean
}

class Movements {
    - timestamp: String
    - type: MovementType
    - boxID: String
    - sku: String
    - qty: int
    - fromLocation: String
    - toLocation: String
    - orderID: String
    - notes: String
    + getType(): MovementType
    + getTimestamp(): String
    + getBoxID(): String
    + getSku(): String
    + getQty(): int
    + getFromLocation(): String
    + getToLocation(): String
    + getOrderID(): String
    + getNotes(): String
    + setOrderID(orderID: String): void
    + setNotes(notes: String): void
    + toCSV(): String
    + getCSVHeader(): String {static}
}

enum MovementType {
    UNLOAD
    DISPATCH
    RELOCATE
    RETURN
    + getDescription(): String
}

enum ReturnReasons {
    REMORSE
    DAMAGED
    EXPIRED
    CYCLE_COUNT
    + getDescription(): String
    + shouldBeDiscarded(): boolean
    + shouldBeRestocked(): boolean
    + parse(raw: String): ReturnReasons {static}
}

' Relationships
Box ..|> Comparable
' Composition relationships (owns/creates)
Warehouse "1" *-- "*" Bay : manages
Warehouse "1" *-- "*" Movements : records
Order "1" *-- "*" OrderLines : contains
' Aggregation (contains but doesn't own)
Bay "1" o-- "*" Box : contains (FEFO/FIFO ordered)
' Association
Warehouse "1" --> "*" Item : has catalog
Warehouse "1" --> "*" Order : manages
Warehouse "1" --> "*" Returns : manages
' Dependency
Warehouse ..> Wagon : receives from
Movements ..> Box : references (via boxID)
' Reference
Box "*" --> "1" Item : references (via SKU)
OrderLines "*" --> "1" Item : references (via SKU)
Returns "*" --> "1" Item : references (via SKU)
Returns "*" --> "1" ReturnReasons : has reason

@enduml