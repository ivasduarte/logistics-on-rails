@startuml
!theme plain

actor "Warehouse Planner" as plan
participant "System" as sys

activate plan

plan -> sys: processExistingOrders()
activate sys

sys -> sys: allocateOrder()
note right: This method is responsible for:\n - Receiving the Organization Mode\n - Allocate quantities to each order line\n - Generate line reports\n - Give a full order report

sys --> plan: generateSummaryReport()
deactivate sys

@enduml