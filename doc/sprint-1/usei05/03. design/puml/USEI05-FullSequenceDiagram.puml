@startuml USEI05-FullSequenceDiagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 2
skinparam roundcorner 20
skinparam maxmessagesize 60

actor "Quality Operator" as QO
participant "ReturnsManager" as RM
participant "QuarantineQueue" as QQ
participant "InventoryInspection" as II
participant "AuditLog" as AL
participant "Warehouse" as WH
participant "Box" as B

== Receive New Return ==

QO -> RM: receiveReturn(returnItem)
activate RM

RM -> QQ: addReturn(returnItem)
activate QQ
note right: Item added to quarantine\n(latest timestamp first,\nties by returnID ASC)
deactivate QQ

deactivate RM

== Process Returns in Quarantine ==

loop while quarantine not empty

    QO -> RM: processReturns()
    activate RM

    RM -> QQ: getNextForInspection()
    activate QQ
    QQ --> RM: returnedItem
    deactivate QQ

    alt returnedItem != null

        RM -> II: inspect(returnedItem)
        activate II

        II -> II: shouldBeDiscarded(returnedItem)

        alt reason = DAMAGED or EXPIRED

            II -> AL: logInspection(returnID, sku, qty, 0, qty, DISCARDED)
            activate AL
            deactivate AL

        else reason = REMORSE or CYCLE_COUNT

            II -> II: restock(returnedItem)

            create B
            II -> B: new Box("RET-"+returnID, sku, qty, expiryDate, now())

            II -> WH: insertBox(newBox)
            activate WH
            note right: FEFO/FIFO insertion rules
            deactivate WH

            II -> AL: logInspection(returnID, sku, qty, qty, 0, RESTOCKED)
            activate AL
            deactivate AL

        end

        deactivate II

    else no items in quarantine

        note over RM: "No returns to process"

    end

    deactivate RM

end

@enduml