@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Returns {
  - returnID : String
  - sku : String
  - qty : int
  - reason : ReturnReasons
  - timestamp : String
  - expiryDate : String
  - discarded : boolean
  + getReturnID() : String
  + getSku() : String
  + getQty() : int
  + getReason() : ReturnReasons
  + getTimestamp() : String
  + getExpiryDate() : String
  + isExpired() : boolean
  + isDamaged() : boolean
  + isCustomerRemorse() : boolean
  + isCycleCount() : boolean
}

enum ReturnReasons {
  REMORSE
  DAMAGED
  EXPIRED
  CYCLE_COUNT
  + getDescription() : String
  + shouldBeDiscarded() : boolean
  + shouldBeRestocked() : boolean
  + parse(raw : String) : ReturnReasons
}

enum StockAction {
  DISCARDED
  RESTOCKED
}

class InventoryInspection {
  - warehouse : Warehouse
  - auditLog : AuditLog
  + shouldBeDiscarded(returnedItem : Returns) : boolean
  + inspect(returnedItem : Returns) : void
  + restock(returnedItem : Returns) : void
}

class ReturnsManager {
  + quarantineQueue : QuarantineQueue
  + inspection : InventoryInspection
  + receiveReturn(returnItem : Returns) : void
  + processReturns() : void
}

class QuarantineQueue {
  - quarantinedItems : List<Returns>
  + addReturn(returnItem : Returns) : void
  + getNextForInspection() : Returns
}

class AuditLog {
  - LOG_FILE_PATH : String
  - LOG_FILE_NAME : String
  + logInspection(returnID : String, sku : String, quantity : int, qtyRestocked : int, qtyDiscarded : int, action : StockAction) : void
}

class Warehouse {
  + insertBox(box : Box) : void
}

class Box {
  - boxID : String
  - sku : String
  - quantity : int
  - expiryDate : LocalDateTime
  - receivedAt : String
}

' Relationships

Returns "1" -- "1" ReturnReasons : has
ReturnsManager "1" -- "1" QuarantineQueue : manages
ReturnsManager "1" -- "1" InventoryInspection : uses
InventoryInspection "1" -- "1" Warehouse : depends on
InventoryInspection "1" -- "1" AuditLog : uses
QuarantineQueue "1" -- "*" Returns : contains
InventoryInspection "1" -- "*" Box : creates
Box "1" -- "1" Warehouse : stored in

@enduml