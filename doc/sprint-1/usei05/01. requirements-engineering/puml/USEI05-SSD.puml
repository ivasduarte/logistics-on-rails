@startuml
!theme plain
skinparam sequenceArrowThickness 2
skinparam roundcorner 20

actor "Quality Operator" as QO
participant "System" as SYS

activate QO
QO -> SYS : receive new return
deactivate QO
activate SYS

SYS -> SYS: adds return
SYS -> SYS: validates returned item
SYS -> SYS: adds returned item to quarantine queue

SYS -> QO: processes returned item in inspection in correct order
SYS -> QO: checks if returned item should or not de discarded
SYS -> QO: keeps every movement done of a returned item registered in an audit file
SYS -> QO: quarantine processing complete
deactivate SYS
activate QO


@enduml