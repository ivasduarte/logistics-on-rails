@startuml
!theme plain
skinparam sequenceArrowThickness 2
skinparam roundcorner 20
skinparam sequenceMessageAlign direction

actor "Quality Operator"
participant "System"

activate "Quality Operator"

== 1. Receive Returns ==

"Quality Operator" -> "System" : Receive return
activate "System"

"System" -> "Quality Operator" : Confirmation
deactivate "System"

==  2. Process Quarantined Items ==

loop while Quarantine Isn't Empty
    "Quality Operator" -> "System" : Process returns
    activate "System"

    alt Item Should Be Discarded \n(Damaged or Expired)
        "System" -> "Quality Operator" : Item discarded, Audit logged
    else Item Should Be Restocked \n(Remorse or Cycle Count)
        "Quality Operator" -> "System" : Restock item
        "System" -> "Quality Operator" : Item restocked, Audit logged
    end
end



@enduml