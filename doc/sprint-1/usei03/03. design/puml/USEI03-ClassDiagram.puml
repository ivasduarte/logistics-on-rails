@startuml
' Class Diagram: USEI03 - Picking Plans with Packing Heuristics

class PickingPlanService {
    - itemWeights: Map<String, Double>
    - allowSplitting: boolean
    + PickingPlanService(itemWeights: Map<String, Double>)
    + PickingPlanService(itemWeights: Map<String, Double>, allowSplitting: boolean)
    + createPickingPlan(allocations: List<Allocation>, trolleyCapacity: double, heuristic: PackingHeuristic): PickingPlan
    + compareHeuristics(allocations: List<Allocation>, trolleyCapacity: double): Map<PackingHeuristic, PickingPlan>
    + generateComparisonReport(allocations: List<Allocation>, trolleyCapacity: double): String
    - calculateWeights(allocations: List<Allocation>): List<AllocationWeight>
    - firstFit(allocationsWithWeights: List<AllocationWeight>, trolleyCapacity: double): PickingPlan
    - firstFitDecreasing(allocationsWithWeights: List<AllocationWeight>, trolleyCapacity: double): PickingPlan
    - bestFitDecreasing(allocationsWithWeights: List<AllocationWeight>, trolleyCapacity: double): PickingPlan
    - handleSplitting(aw: AllocationWeight, targetTrolley: Trolley, originalQuantity: Integer): AllocationWeight
    + getItemWeights(): Map<String, Double>
    + setItemWeights(itemWeights: Map<String, Double>): void
    + isAllowSplitting(): boolean
    + setAllowSplitting(allowSplitting: boolean): void
}

class PickingPlan {
    - heuristic: PackingHeuristic
    - trolleyCapacity: double
    - trolleys: List<Trolley>
    - totalAllocations: int
    - totalWeight: double
    - skippedAllocations: List<SkippedAllocation>
    + PickingPlan(heuristic: PackingHeuristic, trolleyCapacity: double)
    + getHeuristic(): PackingHeuristic
    + getTrolleyCapacity(): double
    + getTrolleys(): List<Trolley>
    + getTrolleyCount(): int
    + getTotalAllocations(): int
    + getTotalWeight(): double
    + getSkippedAllocations(): List<SkippedAllocation>
    + getSkippedCount(): int
    + getAverageUtilization(): double
    + addTrolley(trolley: Trolley): void
    + addSkippedAllocation(allocation: Allocation, weight: double): void
    + generateSummaryReport(): String
    + generateDetailedPickingList(): String
    - recalculateMetrics(): void
}

class Trolley {
    - trolleyNumber: int
    - capacityWeight: double
    - usedWeight: double
    - allocationEntries: List<AllocationEntry>
    - logs: List<String>
    + Trolley(trolleyNumber: int, capacityWeight: double)
    + getTrolleyNumber(): int
    + getCapacityWeight(): double
    + getUsedWeight(): double
    + getRemainingCapacity(): double
    + getAllocations(): List<Allocation>
    + getAllocationEntries(): List<AllocationEntry>
    + getLogs(): List<String>
    + getUtilization(): double
    + getAllocationCount(): int
    + isEmpty(): boolean
    + addAllocation(allocation: Allocation, weight: double): boolean
    + addAllocation(allocation: Allocation, weight: double, isPartial: boolean, originalQuantity: Integer): boolean
    + addLog(logMessage: String): void
    + canFit(weight: double): boolean
}

class AllocationWeight {
    - allocation: Allocation
    - weight: double
    - isPartial: boolean
    - originalQuantity: Integer
    + AllocationWeight(allocation: Allocation, weight: double)
    + AllocationWeight(allocation: Allocation, weight: double, isPartial: boolean, originalQuantity: Integer)
    + getAllocation(): Allocation
    + getWeight(): double
    + isPartial(): boolean
    + getOriginalQuantity(): Integer
    + setAllocation(allocation: Allocation): void
    + setWeight(weight: double): void
    + setPartial(partial: boolean): void
    + setOriginalQuantity(originalQuantity: Integer): void
    + compareTo(other: AllocationWeight): int
}

interface Comparable <<interface>> {
    + compareTo(o: AllocationWeight): int
}

class Allocation {
    - orderID: String
    - boxID: String
    - warehouseId: String
    - sku: String
    - lineNo: int
    - aisle: int
    - bayNumber: int
    - quantityAllocated: int
    + getOrderID(): String
    + getBoxID(): String
    + getWarehouseId(): String
    + getSku(): String
    + getLineNo(): int
    + getAisle(): int
    + getBayNumber(): int
    + getQuantityAllocated(): int
}

enum PackingHeuristic {
    FIRST_FIT
    FIRST_FIT_DECREASING
    BEST_FIT_DECREASING
}

AllocationWeight ..|> Comparable

PickingPlanService "1" -- "*" PickingPlan : creates
PickingPlanService ..> PackingHeuristic : uses
PickingPlanService ..> AllocationWeight : creates

PickingPlan "1" -- "*" Trolley : contains
PickingPlan ..> PackingHeuristic : uses

AllocationWeight "*" --> "1" Allocation : wraps

@enduml