@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

hide circle
hide methods

class PickingPlan {
    heuristic: PackingHeuristic
    trolleyCapacity: double
    totalAllocations: int
    totalWeight: double
}

class Trolley {
    trolleyNumber: int
    capacityWeight: double
    usedWeight: double
}

class PickingPlanService {
    allowSplitting: boolean
}

class AllocationWeight {
    weight: double
    isPartial: boolean
    originalQuantity: Integer
}

enum PackingHeuristic {
    FIRST_FIT
    FIRST_FIT_DECREASING
    BEST_FIT_DECREASING
}

PickingPlan "1" *-- "*" Trolley : contains
PickingPlan "1" -- "1" PackingHeuristic : uses
PickingPlanService "1" -- "*" PickingPlan : creates
PickingPlanService "1" ..> AllocationWeight : uses

@enduml