@startuml
!theme plain
skinparam classAttributeSize 0
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam Shadowing false
skinparam ArrowFontSize 12
skinparam nodesep 80
skinparam ranksep 80

class NetworkUI {
    + railHubAnalysis(): void
    - showSuccess(msg: String): void
    - showError(msg: String): void
}

class NetworkController {
    - graph: Graph<Station, ConnectionData>
    + calculateAndRankHubs(n: int): List<HubMetrics<Station>>
    + exportHubsToCSV(filename: String, topN: int): void
}

class HubService {
    + calculateHubScores(graph: Graph, ...): Map<V, HubMetrics<V>>
    + getTopHubs(metrics: Map, n: int): List<HubMetrics>
    - normalizeMap(rawMap: Map): Map
}

class HubMetrics<V> {
    - vertex: V
    - degree: double
    - strength: double
    - betweenness: double
    - harmonic: double
    - hubScore: double
    + getHubScore(): double
}

class Algorithms {
    + {static} betweennessCentrality(g: Graph, ...): Map<V, Double>
    + {static} harmonicCentrality(g: Graph, ...): Map<V, Double>
    + {static} calculateStrength(g: Graph, ...): Map<V, Double>
    + {static} normalizeCentrality(centrality: Map, ...): Map<V, Double>
}

class Station {
    - id: String
    - name: String
    - latitude: double
    - longitude: double
    + getNodeID(): String
}

class ConnectionData {
    - distance: double
    - capacity: double
    - cost: double
    + getDistance(): double
}

interface Graph<V, E> {
    + vertices(): Iterable<V>
    + edges(): Iterable<Edge<V, E>>
    + adjVertices(v: V): Collection<V>
}

class Edge<V, E> {
    - weight: E
    + getWeight(): E
}

' Relationships
NetworkUI ..> NetworkController : invokes
NetworkController "1" o-- "1" Graph : holds >
NetworkController ..> HubService : uses
NetworkController ..> HubMetrics : retrieves >

HubService ..> Algorithms : invokes
HubService ..> HubMetrics : creates >
HubService ..> Graph : processes

Graph "1" *-- "*" Edge : contains
Graph "1" --> "*" Station : contains vertices
Edge "1" --> "1" ConnectionData : wraps >

Algorithms ..> Graph : traverses

@enduml