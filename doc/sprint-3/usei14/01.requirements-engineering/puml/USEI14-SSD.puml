@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Operations Analyst" as analyst
participant ":System" as sys

activate analyst

analyst -> sys: Requests maximum flow calculation
activate sys
sys --> analyst: Asks for source and sink stations
deactivate sys

analyst -> sys: Inputs source and sink stations
activate sys
sys --> analyst: Returns maximum flow summary
deactivate sys

deactivate analyst

@enduml