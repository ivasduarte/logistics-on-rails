@startuml
skinparam classAttributeSize 8
skinparam linetype ortho

class MaximumFlowUI {
    + computeMaxFlow(): void
    - showSuccess(msg: String): void
    - showError(msg: String): void
}

class MaximumFlow {
    + findAugmentationPath(graph: Graph, currentVertex: V, sink: V, visited: boolean[], path: LinkedList<V>): List<Edge<V, E>>
    + getPathMinCap(graph: Graph, path: LinkedList<V>): int
    + updateResidualGraph(graph: Graph, path: LinkedList<V>, flow: int): void
    + maxFlow(graph: Graph, source: V, sink: V): Integer
}

class Station {
    - id: String
    - name: String
    - latitude: double
    - longitude: double
    + getNodeID(): String
}

interface Graph<V, E> {
    + numVertices(): int
    + vertices(): Iterable<V>
    + edges(): Iterable<Edge<V, E>>
    + adjVertices(v: V): Collection<V>
}

class Edge<V, E> {
    - weight: E
    + getWeight(): E
}

MaximumFlowUI ..> MaximumFlow

MaximumFlow o-- Graph : holds >

Graph "1" *-- "*" Station : contains vertices
Graph "1" --> "1" Edge : contains edges

@enduml