@startuml
skinparam classAttributeSize 8

class NetworkUI{}

class NetworkController{
    + shortestPathBellmanFord(vOrig: Station, vDest: Station, ...): Double
    + getStationByID(id: String): Station
}

class ConnectionData{
    - distance: double
    - capacity: double
    - cost: double
    + getCost(): double
    + getDistance(): double
}

class Station{
    - nodeID: String // The unique identifier
    - stationName: String
    - stationLatitude: double
    + getNodeID(): String
}

class Algorithms{
    + bellmanFord(g: Graph<V, E>, vOrig: V, ...): boolean
    + shortestPathBellmanFord(g: Graph<V, E>, vOrig: V, vDest: V, ...): E
    - relaxation(...)
    - checkNegativeCycles(...)
}

interface Graph <V, E>{
    + numVertices(): int
    + edges(): Iterable<Edge<V, E>>
    + validVertex(vert: V): boolean
    + key(vert: V): int
}

class Edge <V, E>{
    - vOrigin: V
    - vDestination: V
    - weight: E
    + getWeight(): E
    + getVOrigin(): V
    + getVTarget(): V
}


' Relationships

' UI and Controller
NetworkUI ..> NetworkController

' Controller and Graph/Algorithms
NetworkController "1" *-- "1" Graph : owns (network)
NetworkController ..> Algorithms : uses (shortestPathBellmanFord)

' Graph Structure
Graph "1" *-- "*" Edge : contains
Graph "1" *-- "*" Station : vertices are

' Edge Payload
Edge "1" --> "1" ConnectionData : wraps/weight

' Algorithms Dependencies
Algorithms ..> Graph : traverses
Algorithms ..> Edge : reads weight
Algorithms ..> Station : manipulates path (V)

@enduml