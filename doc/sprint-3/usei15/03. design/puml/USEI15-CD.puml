@startuml
skinparam classAttributeSize 8
skinparam linetype ortho

class RoutePlannerUI{}

class RoutePlannerController{
    + calcShortestPath(originID: String, targetID: String): String
}

class FreightNetwork{
    - network: Graph<Station, Line>
    + getShortestPath(origin: Station, target: Station): PathResult
    + getStationByID(id: String)
}

class Station{
    - stationID: int
    - stationName: String
    - stationLatitude: double
    - stationLongitude: double
    + getStationID(): int
}

class Line{
    - distance: double
    - capacity: double
    - cost: double
    + getCost(): double
}

class PathResult{
    - path: List<Station>
    - totalCost: double
    - hasNegativeCycle: boolean
    + toString(): String
}

class BellmanFord{
    + shortestPath(graph: Graph<V, E>, vOrigin: V , vTarget: V): LinkedList<V>
    - relaxesEdges(graph: Graph<V, E>, distance: Map<V, Double>, predecessor: Map<V, V>): void
    - checkNegative(graph: Graph<V, E>, distance: Map<V, Double>): boolean
}

interface Graph <V, E>{
    + numVertices(): int
    + vertices(): Iterable<V>
    + edges(): Iterable<Edge<V, E>>
    + incomingEdges(vertice: V): Iterable<Edge<V, E>>
}

class Edge <V, E>{
    - weight: double
    + getWeight(): double
    + getVOrigin(): V
    + getVTarget(): V
}

'relationships
RoutePlannerUI ..> RoutePlannerController
RoutePlannerController ..> FreightNetwork
FreightNetwork "1" o-- "1" Graph : owns
FreightNetwork ..> BellmanFord : uses
BellmanFord ..> PathResult : creates
BellmanFord ..> Graph : traverses

Graph "1" *-- "*" Edge : contains
Graph "1" *-- "*" Station : vertices are
Edge "1" --> "1" Line : wraps

@enduml