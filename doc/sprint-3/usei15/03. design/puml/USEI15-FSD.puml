@startuml
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

actor "Route Planner" as RP
participant ":NetworkUI" as UI
participant ":NetworkController" as C
participant ":Graph<Station, ConnectionData>" as FN_Graph
participant ":Graph<Station, Double>" as Cost_Graph
participant ":Algorithms" as A

autonumber

activate RP
RP -> UI : requests risk-aware shortest path (origID, targetID)
activate UI

UI -> C : shortestPathBellmanFord(vOrig, vDest, ...)
activate C

    group Prepare Cost Graph (Risk-Aware)
        C -> Cost_Graph **: create(directed=true)
        C -> FN_Graph : vertices()
        FN_Graph --> C : V
        C -> FN_Graph : edges()
        FN_Graph --> C : iterator<Edge>

        loop for each edge e in FN_Graph
            C -> C : cost = ABS(e.getWeight().getCost())
            C -> Cost_Graph : addEdge(u, v, cost)
        end
    end

    C -> A : shortestPathBellmanFord(costGraph, vOrig, vDest, ...)
    activate A

        A -> A : initialize dist[] = infinity, dist[orig] = 0
        A -> Cost_Graph : numVertices()
        Cost_Graph --> A : V

        loop Relaxation Phase (1 to V-1)
            A -> Cost_Graph : edges()
            loop for each edge (u, v, w) in Cost_Graph
                A -> A : relax(u, v, w) // dist[u] + w < dist[v]
            end
        end

        A -> A : checkNegativeCycles() // V-th iteration
        alt Negative Cycle Detected
            A --> C : result (null, cycle_path)
        else
            A -> A : reconstructPath(predecessors, vDest)
            A --> C : result (totalCost, shortestPath)
        end

    deactivate A

C --> UI : formatted result string (totalCost/path OR error)
deactivate C

UI --> RP : shows path and cost OR error message
deactivate UI
deactivate RP
@enduml