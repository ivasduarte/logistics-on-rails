@startuml
!theme plain
skinparam classAttributeSize 0
skinparam defaultTextAlignment center
skinparam pakcageStyle rectangle
skinparam Shadowing false
skinparam ArrowFontSize 12
skinparam nodesep 80
skinparam ranksep 80

class RoutePlannerController{
    + calcShortestPath(originID: String, targetID: String): String
}

class FreightNetwork{
    - network: Graph<Station, Line>
    + getShortestPath(origin: Station, target: Station): PathResult
    + getStationByID(id: String)
}

class Station{}

class Line{}

class BellmanFord{
    + shortestPath(graph: Graph<V, E>, vOrigin: V , vTarget: V): LinkedList<V>
    - relaxesEdges(graph: Graph<V, E>, distance: Map<V, Double>, predecessor: Map<V, V>): void
    - checkNegative(graph: Graph<V, E>, distance: Map<V, Double>): boolean
}

interface Graph<V, E>{
    + numVertices(): int
    + vertices(): Iterable<V>
    + edges(): Iterable<Edge<V, E>>
    + incomingEdges(vertice: V): Iterable<Edge<V, E>>
}

class Edge{
    - weight: double
    + getWeight(): double
    + getVOrigin(): V
    + getVTarget(): V
}

'relationships
RoutePlannerController ..> FreightNetwork : uses
FreightNetwork "1" o-- "1" Graph: holds >
FreightNetwork ..> BellmanFord : invokes
BellmanFord ..> Graph : traverses

Graph "1" *-- "*" Edge: contains
Edge "1" --> "1" Line: wraps >
Graph "1" --> "*" Station: contains vertices


@enduml