@startuml
!theme plain
skinparam classAttributeSize 0
skinparam defaultTextAlignment center
skinparam pakcageStyle rectangle
skinparam Shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 12
skinparam nodesep 80
skinparam ranksep 80

class NetworkUI{}

class NetworkController{}

class ConnectionData{
    - distance: double
    - capacity: double
    - cost: double
}

class Station{
    - nodeID: String
    - stationName: String
    - stationLatitude: double
}

class Algorithms{
    - relaxation(...)
    - checkNegativeCycles(...)
}

interface Graph <V, E>{
}

class Edge <V, E>{
    - vOrigin: V
    - vDestination: V
    - weight: E
}


' Relationships

' UI and Controller
NetworkUI ..> NetworkController

' Controller and Graph/Algorithms
NetworkController "1" *-- "1" Graph : owns (network)
NetworkController ..> Algorithms : uses (shortestPathBellmanFord)

' Graph Structure
Graph "1" *-- "*" Edge : contains
Graph "1" *-- "*" Station : vertices are

' Edge Payload
Edge "1" --> "1" ConnectionData : wraps/weight

' Algorithms Dependencies
Algorithms ..> Graph : traverses
Algorithms ..> Edge : reads weight
Algorithms ..> Station : manipulates path (V)

@enduml