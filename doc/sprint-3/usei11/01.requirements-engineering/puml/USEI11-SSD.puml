@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Infrastructure Planner" as Planner
participant ":System" as System

activate Planner

Planner -> System : asks to compute directed line upgrade plan
    activate System

    alt Graph is acyclic (DAG)
        == Successful Ordering ==
        System --> Planner : outputs order of all vertices \n(station ID and name in upgrade sequence)
    else Graph contains cycles
        == Cycle Detection ==
        System --> Planner : outputs stations involved in cycles \n(station ID and name) \nand cycle details
    end

    deactivate System

deactivate Planner

@enduml