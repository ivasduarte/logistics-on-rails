@startuml
!theme plain
skinparam classAttributeSize 0
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam Shadowing false
skinparam ArrowFontSize 12
skinparam nodesep 80
skinparam ranksep 80

class NetworkUI {
    + minimalBackboneNetwork(): void
    - showSuccess(msg: String): void
    - showError(msg: String): void
}

class NetworkController {
    - graph: Graph<Station, ConnectionData>
    + computeMinimalBackbone(): Graph<Station, ConnectionData>
    + exportMinimalBackboneToGraphviz(mst: Graph, filename: String): void
    + calculateMSTStatistics(mst: Graph): Map<String, Double>
}

class Algorithms {
    + {static} minimumSpanningTree(g: Graph, ce: Comparator): Graph
    - {static} addEdgesToQueue(g: Graph, vertex: V, visited: Set, pq: PriorityQueue): void
}

class Station {
    - id: String
    - name: String
    - latitude: double
    - longitude: double
    - x: double
    - y: double
    + getNodeID(): String
    + getStationName(): String
    + getX(): double
    + getY(): double
}

class ConnectionData {
    - distance: double
    - capacity: double
    - cost: double
    + getDistance(): double
}

interface Graph<V, E> {
    + isDirected(): boolean
    + vertices(): ArrayList<V>
    + edges(): Collection<Edge<V, E>>
    + numVertices(): int
    + outgoingEdges(v: V): Collection<Edge<V, E>>
    + incomingEdges(v: V): Collection<Edge<V, E>>
}

class Edge<V, E> {
    - vOrigin: V
    - vTarget: V
    - weight: E
    + getVOrigin(): V
    + getVTarget(): V
    + getWeight(): E
}

' Relationships
NetworkUI ..> NetworkController : invokes
NetworkController "1" o-- "1" Graph : holds >
NetworkController ..> Algorithms : invokes

Algorithms ..> Graph : processes

Graph "1" *-- "*" Edge : contains
Graph "1" --> "*" Station : contains vertices
Edge "1" --> "1" ConnectionData : wraps >

@enduml