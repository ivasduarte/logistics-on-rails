@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Planner" as Planner
participant ":System" as System

activate Planner

Planner -> System : asks to search stations by radius
    activate System
    == Input Operation ==
    System --> Planner : requests target coordinates (lat, lon) and radius (km)
    deactivate System

Planner -> System : inputs target (lat, lon) and radius
    activate System
    == Output Operation ==
    System --> Planner : outputs sorted stations (BST/AVL) and density summary
    deactivate System

deactivate Planner
@enduml